{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/v1/billing/paypal/subscriptions",
      "destination": "/api/paypal-subscriptions"
    },
    {
      "source": "/api/v1/billing/paypal/subscriptions/cancel",
      "destination": "/api/paypal-subscriptions-cancel"
    },
    {
      "source": "/api/v1/billing/paypal/confirm",
      "destination": "/api/paypal-subscriptions-confirm"
    },
    {
      "source": "/webhooks/paypal",
      "destination": "/api/paypal-webhook"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "go.ventalink.app" }],
      "destination": "/api/go-html"
    },
    {
      "source": "/catalogo/:slug",
      "destination": "/api/catalog-html?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
