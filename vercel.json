{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "go.ventalink.app" }],
      "destination": "/api/go-html"
    },
    {
      "source": "/catalogo/:slug",
      "destination": "/api/catalog-html?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
