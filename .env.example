# Supabase (obligatorias para el build en Vercel)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL base pública del frontend (producción: https://app.gong.cl)
# En Vercel: configurar VITE_APP_URL=https://app.gong.cl
VITE_APP_URL=https://app.gong.cl

# Mercado Pago (para pagos de planes Pro/Business) — configurar en Supabase Dashboard > Project Settings > Edge Functions > Secrets
# MP_ACCESS_TOKEN = Access Token de tu aplicación en https://www.mercadopago.cl/developers/panel/app
# MP_WEBHOOK_URL = https://tu-proyecto.supabase.co/functions/v1/mp-webhook (para notificaciones de pago)
