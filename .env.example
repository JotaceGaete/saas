# Supabase (obligatorias para el build en Vercel)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# IA — descripción de producto (backend Ventalink). Producción canónica:
# VITE_AI_PRODUCT_DESCRIPTION_URL=https://go.ventalink.app/api/v1/ai/generate-product-description
# Si omites la variable en build de producción, el código usa esa URL por defecto.

# URL base pública del frontend (producción: https://go.ventalink.app)
# En Vercel: opcional; si no se define, se usa window.location.origin.
# VITE_APP_URL=https://go.ventalink.app

# Opcional: Worker que genera og:image 1200×630 (ej. /api/og-image?store=UUID). Si no se define, og:image = portada R2.
# VITE_OG_IMAGE_API_BASE=https://tu-worker.workers.dev

# Mercado Pago — modo prueba: usar credenciales de "Pruebas" en https://www.mercadopago.cl/developers/panel/app
# Public Key de prueba (solo si usas SDK/Bricks en el frontend; Checkout Pro por redirección no la necesita):
# VITE_MP_PUBLIC_KEY = APP_USR-xxxx (credenciales de Pruebas > Public Key)
#
# Access Token y Webhook se configuran en Supabase (ver abajo), no aquí.
#
# dLocal Go: no se usa.
#
# Activación manual de planes (fuera de Chile): número WhatsApp soporte, solo dígitos (sin +).
# VITE_PLANS_SUPPORT_WHATSAPP=56912345678
# DLOCAL_BASE_URL=https://api-sbx.dlocalgo.com
# BILLING_DLOCAL_ENABLED=false
# rerr