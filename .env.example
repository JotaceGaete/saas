# Supabase (obligatorias para el build en Vercel)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL base pública del frontend (producción: https://cl.ventalink.app o https://ar.ventalink.app)
# En Vercel: opcional; si no se define, se usa window.location.origin (recomendado para ar/cl).
# VITE_APP_URL=https://cl.ventalink.app
# VITE_APP_URL=https://ar.ventalink.app

# Mercado Pago — modo prueba: usar credenciales de "Pruebas" en https://www.mercadopago.cl/developers/panel/app
# Public Key de prueba (solo si usas SDK/Bricks en el frontend; Checkout Pro por redirección no la necesita):
# VITE_MP_PUBLIC_KEY = APP_USR-xxxx (credenciales de Pruebas > Public Key)
#
# Access Token y Webhook se configuran en Supabase (ver abajo), no aquí.
#
# dLocal Go: no se usa. Variables DLOCAL_GO_* pueden eliminarse de Supabase si existían.
#
# Paddle (pagos fuera de Chile): configurar en Supabase > Project Settings > Edge Functions > Secrets:
#   PADDLE_API_KEY = tu API key de Paddle (sandbox: pdl_sdbx_apikey_...; producción: pdl_live_...).
#   PADDLE_ENV = sandbox | production (opcional; por defecto sandbox).
# No poner la API key aquí; solo se usa en el backend (Edge Functions).
