# Supabase (obligatorias para el build en Vercel)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
#
# Servicio externo de media para imagen principal de producto
# VITE_MEDIA_SERVICE_URL=http://46.225.175.62:3002
# Tamaño máximo permitido para imágenes de producto (bytes)
# VITE_PRODUCT_IMAGE_MAX_BYTES=10485760

# IA — descripción de producto (backend Ventalink). Producción canónica:
# VITE_AI_PRODUCT_DESCRIPTION_URL=https://go.ventalink.app/api/v1/ai/generate-product-description
# Si omites la variable en build de producción, el código usa esa URL por defecto.

# URL base pública del frontend (producción: https://go.ventalink.app)
# En Vercel: opcional; si no se define, se usa window.location.origin.
# Nunca uses https://www.ventalink.app aquí: el manifest/PWA deben resolver en el mismo host (p. ej. go).
# VITE_APP_URL=https://go.ventalink.app

# Dominio pÃºblico canÃ³nico del catÃ¡logo compartible.
# Se usa para botones "Ver catÃ¡logo", WhatsApp, canonical, OG y sitemap.
VITE_PUBLIC_CATALOG_URL=https://miralatienda.de

# Opcional: Worker que genera og:image 1200×630 (ej. /api/og-image?store=UUID). Si no se define, og:image = portada R2.
# VITE_OG_IMAGE_API_BASE=https://tu-worker.workers.dev

# /api/og-catalog: si true, no descarga portada/logo remotos; PNG determinista solo con SVG (mismo slug → mismo render).
# OG_CATALOG_VECTOR_ONLY=true

# Mercado Pago — modo prueba: usar credenciales de "Pruebas" en https://www.mercadopago.cl/developers/panel/app
# Public Key de prueba (solo si usas SDK/Bricks en el frontend; Checkout Pro por redirección no la necesita):
# VITE_MP_PUBLIC_KEY = APP_USR-xxxx (credenciales de Pruebas > Public Key)
#
# Access Token y Webhook se configuran en Supabase (ver abajo), no aquí.
#
# dLocal Go: no se usa.
#
# Activación manual de planes (fuera de Chile): número WhatsApp soporte, solo dígitos (sin +).
# Por defecto el build usa el mismo número que src/config/support.js (SUPPORT_WHATSAPP_NUMBER).
# VITE_PLANS_SUPPORT_WHATSAPP=542966544879
# DLOCAL_BASE_URL=https://api-sbx.dlocalgo.com
# BILLING_DLOCAL_ENABLED=false
# PayPal Billing — Plan IDs (por entorno). Si no hay fila en `paypal_plan_mappings`, el backend usa estos valores.
# PAYPAL_MODE=live|sandbox
# PAYPAL_PLAN_ID_PRO_LIVE=P-xxxxxxxx
# PAYPAL_PLAN_ID_FULL_LIVE=P-yyyyyyyy
# PAYPAL_PLAN_ID_PRO_SANDBOX=P-xxxxxxxx
# PAYPAL_PLAN_ID_FULL_SANDBOX=P-yyyyyyyy
# Opcional: mismo ID para todos los entornos (solo desarrollo)
# PAYPAL_PLAN_ID_PRO=P-...
# PAYPAL_PLAN_ID_FULL=P-...

# Backfill / persistencia de Open Graph
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# CATALOG_ORIGIN=https://miralatienda.de
# R2_ACCOUNT_ID=tu-account-id
# R2_ACCESS_KEY_ID=tu-access-key-id
# R2_SECRET_ACCESS_KEY=tu-secret-access-key
# R2_BUCKET_NAME=tu-bucket
# R2_PUBLIC_URL=https://cdn.tu-dominio.com
